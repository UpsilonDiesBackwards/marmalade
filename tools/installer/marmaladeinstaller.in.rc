CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "marmaladeinstaller.exe.manifest"

#define IDI_ICON1 101
IDI_ICON1 ICON "../../../res/icons/logo/logo.ico"

#define IDR_ZIPFILE 102
IDR_ZIPFILE RCDATA "resources/marmalade.zip"

1 VERSIONINFO
    FILEVERSION 1,0,0,0
    PRODUCTVERSION 1,0,0,0
    FILEFLAGSMASK 0x17L
    #ifdef _DEBUG
        FILEFLAGS 0x1L
    #else
        FILEFLAGS 0x0L
    #endif
    FILEOS 0x4L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
    BEGIN
        BLOCK "StringFileInfo"
        BEGIN
            BLOCK "080904b0"
            BEGIN
                VALUE "Comments", "Marmalade Engine Installer"
                VALUE "CompanyName", "Upsilon"
                VALUE "FileDescription", "Marmalade Engine Installer"
                VALUE "FileVersion", "1, 0, 0, 0"
                VALUE "InternalName", "Marmalade Engine Installer"
                VALUE "LegalCopyright", "2025 Tayler Parsons"
                VALUE "ProductName", "Marmalade Engine Installer"
                VALUE "ProductVersion", "1, 0, 0, 0"
            END
        END
        BLOCK "VarFileInfo"
        BEGIN
            VALUE "Translation", 0x809, 1200
        END
    END
